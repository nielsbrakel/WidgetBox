{
  "name": "widgetbox",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm check:static && pnpm test:coverage && pnpm validate",
    "check:static": "biome ci --error-on-warnings . && knip && pnpm kit:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "pnpm -r --filter \"./apps/com.*\" run homey:validate",
    "sandbox": "pnpm --filter sandbox dev",
    "prepare": "node scripts/install-hooks.mjs",
    "test:bundle": "node scripts/check-bundles.mjs",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/sync-homey-versions.mjs && biome format --write apps",
    "release:tag": "changeset git-tag",
    "kit:sync": "node scripts/sync-kit.mjs",
    "kit:check": "node scripts/sync-kit.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.3",
    "homey": "4.5.3",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "lefthook": "2.1.16",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^26.0.0"
  }
}
