{
  "name": "widgetbox",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "validate": "turbo run homey:validate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sandbox": "pnpm --filter sandbox dev",
    "homey:install": "turbo run homey:install --concurrency 1",
    "homey:build": "turbo run homey:build",
    "homey:publish": "turbo run homey:publish --concurrency 1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "homey": "^4.5.3",
    "jsdom": "^30.1.1",
    "turbo": "^2.11.7",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  }
}
