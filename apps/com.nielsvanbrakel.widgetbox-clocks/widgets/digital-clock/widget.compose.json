{
  "name": {
    "en": "Digital Clock",
    "nl": "Digitale klok"
  },
  "description": {
    "en": "Clean digital clock with date and time.",
    "nl": "Strakke digitale klok met tijd en datum."
  },
  "transparent": false,
  "settings": [
    {
      "id": "clockFormat",
      "type": "dropdown",
      "label": {
        "en": "Time Format",
        "nl": "Tijdnotatie"
      },
      "value": "24",
      "values": [
        {
          "id": "24",
          "label": {
            "en": "24-hour",
            "nl": "24-uurs"
          }
        },
        {
          "id": "12",
          "label": {
            "en": "12-hour (AM/PM)",
            "nl": "12-uurs (AM/PM)"
          }
        }
      ]
    },
    {
      "id": "showSeconds",
      "type": "checkbox",
      "label": {
        "en": "Show Seconds",
        "nl": "Seconden tonen"
      },
      "value": false
    },
    {
      "id": "showDate",
      "type": "checkbox",
      "label": {
        "en": "Show Date",
        "nl": "Datum tonen"
      },
      "value": true
