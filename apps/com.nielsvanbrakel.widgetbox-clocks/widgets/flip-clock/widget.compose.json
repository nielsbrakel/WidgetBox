{
  "name": {
    "en": "Flip Clock",
    "nl": "Flipklok"
  },
  "description": {
    "en": "Retro flip clock with animated cards.",
    "nl": "Retro flipklok met bewegende kaartjes."
  },
  "transparent": false,
  "settings": [
    {
      "id": "clockFormat",
      "type": "dropdown",
      "label": {
        "en": "Time Format",
        "nl": "Tijdnotatie"
      },
      "value": "24",
      "values": [
        {
          "id": "24",
          "label": {
            "en": "24-hour",
            "nl": "24-uurs"
          }
        },
        {
          "id": "12",
          "label": {
            "en": "12-hour (AM/PM)",
            "nl": "12-uurs (AM/PM)"
          }
        }
      ]
    },
    {
      "id": "showSeconds",
      "type": "checkbox",
      "label": {
        "en": "Show Seconds",
        "nl": "Seconden tonen"
      },
      "value": false
    },
    {
      "id": "showColons",
      "type": "checkbox",
      "label": {
        "en": "Show Colons",
        "nl": "Dubbele punten tonen"
      },
      "value": true
