      "help": {
        "tank": {
          "title": "Your aquarium",
          "text": "Happy fish drop coins on the sand while you're away. Tap coins to collect them. The coin chest only holds a few hours of coins, so check in once or twice a day."
        },
        "feed": {
          "title": "Feeding",
          "text": "Tap the food button, pick a food and tap the water. Each fish eats certain foods. Food nobody eats sinks and turns into debris, so don't overdo it."
        },
        "clean": {
          "title": "Cleaning",
          "text": "Algae grow on the glass and debris collects on the sand. Tap them to clean up and earn a few coins. Snails, corydoras, plecos and shrimp help clean on their own. A better filter slows it all down."
        },
        "happy": {
          "title": "Happiness",
          "text": "Fish are happiest when fed, in clean water and near decor they like. Some fish need a home: clownfish want an anemone, the moray eel a rock cave. Playing with the light makes fish playful and earn 25% more for a while."
        },
        "breed": {
          "title": "Eggs and rare colours",
          "text": "Two happy adults of the same kind sometimes lay eggs. Tap ready eggs to hatch fry. Every species has two rare colours that only appear from eggs. Collect them all in your Fishdex."
        },
        "progress": {
          "title": "Levels, goals and pearls",
          "text": "Everything you do earns experience. New levels unlock fish, decor and new tanks. Daily goals and trophies give pearls, which buy special decor that boosts a tank's income."
        },
