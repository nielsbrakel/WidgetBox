{
  "name": {
    "en": "Weather map",
    "nl": "Weerkaart"
  },
  "description": {
    "en": "Interactive wind, rain and temperature map powered by Windy.com",
    "nl": "Interactieve wind-, regen- en temperatuurkaart van Windy.com"
  },
  "api": {
    "getLocation": {
      "method": "GET",
      "path": "/location"
    }
  },
  "transparent": false,
  "settings": [
    {
      "id": "latitude",
      "type": "text",
      "label": {
        "en": "Latitude",
        "nl": "Breedtegraad"
      },
      "value": "",
      "hint": {
        "en": "Leave empty to use the location of your Homey. Example: 52.09",
        "nl": "Laat leeg om de locatie van je Homey te gebruiken. Bijvoorbeeld: 52,09"
      }
    },
    {
      "id": "longitude",
      "type": "text",
      "label": {
        "en": "Longitude",
        "nl": "Lengtegraad"
      },
      "value": "",
      "hint": {
        "en": "Leave empty to use the location of your Homey. Example: 5.12",
        "nl": "Laat leeg om de locatie van je Homey te gebruiken. Bijvoorbeeld: 5,12"
      }
    },
    {
      "id": "zoom",
      "type": "number",
      "label": {
        "en": "Zoom level",
        "nl": "Zoomniveau"
      },
      "value": 5,
      "min": 3,
      "max": 11,
      "step": 1,
      "hint": {
        "en": "From 3 (continent) to 11 (city). 5 shows a whole country.",
        "nl": "Van 3 (continent) tot 11 (stad). Met 5 zie je een heel land."
      }
    },
    {
      "id": "overlay",
      "type": "dropdown",
      "label": {
        "en": "Map layer",
        "nl": "Kaartlaag"
      },
      "value": "wind",
      "values": [
        {
          "id": "wind",
          "label": {
            "en": "Wind",
            "nl": "Wind"
          }
        },
        {
          "id": "temp",
          "label": {
            "en": "Temperature",
            "nl": "Temperatuur"
          }
        },
        {
          "id": "rain",
          "label": {
            "en": "Rain",
            "nl": "Regen"
          }
        },
        {
          "id": "clouds",
          "label": {
            "en": "Clouds",
            "nl": "Bewolking"
          }
        },
        {
          "id": "pressure",
          "label": {
            "en": "Pressure",
            "nl": "Luchtdruk"
          }
        }
      ]
    },
    {
      "id": "product",
      "type": "dropdown",
      "label": {
        "en": "Forecast model",
        "nl": "Weermodel"
      },
      "value": "ecmwf",
      "values": [
        {
          "id": "ecmwf",
          "label": {
            "en": "ECMWF",
            "nl": "ECMWF"
          }
        },
        {
          "id": "gfs",
          "label": {
            "en": "GFS",
            "nl": "GFS"
          }
        },
        {
          "id": "nam",
          "label": {
            "en": "NAM (North America)",
            "nl": "NAM (Noord-Amerika)"
          }
        }
      ]
    },
    {
      "id": "level",
      "type": "dropdown",
      "label": {
        "en": "Altitude",
        "nl": "Hoogteniveau"
      },
      "value": "surface",
      "values": [
        {
          "id": "surface",
          "label": {
            "en": "Surface",
            "nl": "Oppervlak"
          }
        },
        {
          "id": "100m",
          "label": {
            "en": "100 m",
            "nl": "100 m"
          }
        },
        {
          "id": "850h",
          "label": {
            "en": "1,500 m (850 hPa)",
            "nl": "1500 m (850 hPa)"
          }
        },
        {
          "id": "500h",
          "label": {
            "en": "5,500 m (500 hPa)",
            "nl": "5500 m (500 hPa)"
          }
        }
      ]
    },
    {
      "id": "aspectRatio",
      "type": "dropdown",
      "label": {
        "en": "Aspect ratio",
        "nl": "Beeldverhouding"
      },
      "value": "16:9",
      "values": [
        {
          "id": "1:1",
          "label": {
            "en": "Square (1:1)",
            "nl": "Vierkant (1:1)"
          }
        },
        {
          "id": "4:3",
          "label": {
            "en": "4:3",
            "nl": "4:3"
          }
        },
        {
          "id": "16:9",
          "label": {
            "en": "16:9",
            "nl": "16:9"
          }
        },
        {
          "id": "21:9",
          "label": {
            "en": "Ultrawide (21:9)",
            "nl": "Ultrabreed (21:9)"
          }
        },
        {
          "id": "3:1",
          "label": {
            "en": "Panoramic (3:1)",
            "nl": "Panoramisch (3:1)"
          }
        }
      ]
    },
    {
      "id": "marker",
      "type": "checkbox",
      "label": {
        "en": "Show location marker",
        "nl": "Locatiemarkering tonen"
      },
      "value": true
    },
    {
      "id": "pressure",
      "type": "checkbox",
      "label": {
        "en": "Show pressure lines",
        "nl": "Isobaren tonen"
      },
      "value": false
    },
    {
      "id": "message",
      "type": "checkbox",
      "label": {
        "en": "Hide promo message",
        "nl": "Promotiebericht verbergen"
      },
      "value": true
    },
    {
      "id": "openDetailsByDefault",
      "type": "checkbox",
      "label": {
        "en": "Show forecast details",
        "nl": "Verwachtingsdetails tonen"
      },
      "value": false,
      "hint": {
        "en": "Shows the detailed forecast for a location below the map.",
        "nl": "Toont de gedetailleerde verwachting voor een locatie onder de kaart."
      }
    },
    {
      "id": "detailLatitude",
      "type": "text",
      "label": {
        "en": "Detail latitude",
        "nl": "Breedtegraad detailweergave"
      },
      "value": "",
      "hint": {
        "en": "Leave empty to use the map location. Example: 52.22",
        "nl": "Laat leeg om de kaartlocatie te gebruiken. Bijvoorbeeld: 52,22"
      }
    },
    {
      "id": "detailLongitude",
      "type": "text",
      "label": {
        "en": "Detail longitude",
        "nl": "Lengtegraad detailweergave"
      },
      "value": "",
      "hint": {
        "en": "Leave empty to use the map location. Example: 6.01",
        "nl": "Laat leeg om de kaartlocatie te gebruiken. Bijvoorbeeld: 6,01"
      }
    },
    {
      "id": "metricTemp",
      "type": "dropdown",
      "label": {
        "en": "Temperature unit",
        "nl": "Eenheid temperatuur"
      },
      "value": "default",
      "values": [
        {
          "id": "default",
          "label": {
            "en": "Match theme",
            "nl": "Volgt thema"
          }
        },
        {
          "id": "°C",
          "label": {
            "en": "Celsius",
            "nl": "Celsius"
          }
        },
        {
          "id": "°F",
          "label": {
            "en": "Fahrenheit",
            "nl": "Fahrenheit"
          }
        }
      ]
    },
    {
      "id": "metricWind",
      "type": "dropdown",
      "label": {
        "en": "Wind unit",
        "nl": "Eenheid wind"
      },
      "value": "default",
      "values": [
        {
          "id": "default",
          "label": {
            "en": "Match theme",
            "nl": "Volgt thema"
          }
        },
        {
          "id": "kmh",
          "label": {
            "en": "km/h",
            "nl": "km/u"
          }
        },
        {
          "id": "ms",
          "label": {
            "en": "m/s",
            "nl": "m/s"
          }
        },
        {
          "id": "knots",
          "label": {
            "en": "Knots",
            "nl": "Knopen"
          }
        },
        {
          "id": "mph",
          "label": {
            "en": "mph",
            "nl": "mph"
          }
        }
      ]
    },
    {
      "id": "metricRain",
      "type": "dropdown",
      "label": {
        "en": "Rain unit",
        "nl": "Eenheid neerslag"
      },
      "value": "default",
      "values": [
        {
          "id": "default",
          "label": {
            "en": "Match theme",
            "nl": "Volgt thema"
          }
        },
        {
          "id": "mm",
          "label": {
            "en": "Millimeters",
            "nl": "Millimeters"
          }
        },
        {
          "id": "in",
          "label": {
            "en": "Inches",
            "nl": "Inches"
          }
        }
      ]
    }
  ]
}
