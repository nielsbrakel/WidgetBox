    "nl": "Regenverwachting"
  },
  "description": {
    "en": "Expected rain for the next 2 hours",
    "nl": "Verwachte regen voor de komende 2 uur"
  },
  "api": {
    "getData": {
      "method": "GET",
      "path": "/"
