{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/.homeybuild",
      "!**/app.json",
      "!**/assets",
      "!**/public/vendor",
      "!pnpm-lock.yaml",
      "!apps/com.nielsvanbrakel.widgetbox-games/widgets/aquarium",
      "!apps/sandbox/src/lib/mocks/aquariumMocks.js",
      "!tests/e2e/games*.spec.ts",
      "!tests/pages/GamesPage.ts"
    ]
  },
  "assist": {
    "enabled": true
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
